--количество детей в группах
SELECT id_group, COUNT(*) AS children_count
FROM child
GROUP BY id_group;

--вывести детей
SELECT
    id_child,
    fio,
    date_birth,
    sex,
    adress
FROM child;
--списко детей с группами и воспитателями
SELECT
    c.fio AS child_name,
    g.group_number,
    e.employee_id,
    e.employee_telephone
FROM child c
JOIN kinder_group g
    ON c.id_group = g.group_id
JOIN employee e
    ON g.group_employee = e.employee_id;
--списко сотрубников с должностями
SELECT
    e.employee_id,
    e.employee_telephone,
    j.job_title_name,
    j.job_title_hourly_pay
FROM employee e
JOIN job_title j
    ON e.employee_job_title = j.job_title_id;
--блюда из завтрака
SELECT
    m.meal_type,
    d.dish_name,
    d.dish_kalori,
    d.dish_gramm
FROM menu mn
JOIN meal m
    ON mn.meal_id = m.meal_id
JOIN dish d
    ON mn.dish_id = d.dish_id
WHERE m.meal_type = 'Завтрак';
--количество детей в группах
SELECT
    g.group_number,
    COUNT(c.id_child) AS children_count
FROM kinder_group g
LEFT JOIN child c
    ON g.group_id = c.id_group
GROUP BY g.group_id, g.group_number
ORDER BY children_count DESC;

--дети без мед осмотра
SELECT
    c.id_child,
    c.fio
FROM child c
WHERE NOT EXISTS (
    SELECT 1
    FROM medical_exam me
    WHERE me.id_child = c.id_child
);

--список зачисленных детей
select
    c.fio
from child as c
join contract c2 on  c.id_child = c2.id_child
join enrollment e on c2.id_contract = e.id_contract;

-- типы активностей по возрастной категории
SELECT
    t.activity_name AS "Название активности",
    CONCAT(
        a.age_category_youngest,
        '–',
        a.age_category_oldest,
        ' лет'
    ) AS "Возрастная категория"
FROM type_activity AS t
JOIN age_category AS a
    ON (t.recommend_young_age IS NULL
        OR t.recommend_young_age <= a.age_category_youngest)
   AND (t.recommend_old_age IS NULL
        OR t.recommend_old_age >= a.age_category_oldest);

--помещения, вмещающие не менее 20 детей, по убыванию площади
select
    p.premises_number
from premises as p
where p.max_count_children >19
order by p.premises_s desc;

--Сотрудники без рабочих смен
SELECT e.employee_id, e.employee_telephone
FROM employee AS e
WHERE NOT EXISTS (
    SELECT 1
    FROM work_shift AS w
    WHERE w.work_shift_employee = e.employee_id
);

--Смены продолжительностью больше 8 часов
SELECT
    work_shift_employee AS employee_id,
    work_shift_time_start,
    work_shift_time_end,
    work_shift_time_end - work_shift_time_start AS duration
FROM work_shift
WHERE work_shift_time_end - work_shift_time_start > INTERVAL '8 hours';

--Блюда, не включённые ни в одно меню
SELECT d.dish_id, d.dish_name
FROM dish AS d
WHERE NOT EXISTS (
    SELECT 1
    FROM menu AS m
    WHERE m.dish_id = d.dish_id
);

--Представители, заключившие больше одного договора
SELECT
    id_parent,
    COUNT(*) AS contract_count
FROM contract
GROUP BY id_parent
HAVING COUNT(*) > 1;

--Дети с действующим зачислением без записи посещаемости за заданную дату

SELECT c.id_child, c.fio
FROM child AS c
WHERE EXISTS (
    SELECT 1
    FROM enrollment AS e
    WHERE e.id_child = c.id_child
      AND e.status = TRUE
      AND e.enrollment_date <= DATE '2026-11-07'
      AND (
          e.withdrawal_date IS NULL
          OR e.withdrawal_date >= DATE '2026-11-07'
      )
)
AND NOT EXISTS (
    SELECT 1
    FROM attendance AS a
    WHERE a.id_child = c.id_child
      AND a.attendance_date = DATE '2026-11-07'
);

