CREATE TABLE contract(
    id_contract integer NOT NULL PRIMARY KEY,
    id_child integer REFERENCES child(id_child),
    id_parent integer NOT NULL REFERENCES parent(id_parent),
    sum numeric NOT NULL,
    number_contract integer  NOT NULL UNIQUE,
    bank text,
    status bool,
    date_start date,
    date_end date,
    id_paying integer NOT NULL REFERENCES  paying(id_paying)
);

CREATE TABLE paying(
    id_paying integer NOT NULL PRIMARY KEY,
    id_parent integer NOT NULL,
    id_contract integer NOT NULL REFERENCES contract(id_contract), --не UNIQUE тк может быть несколько платежей по одному договору
    number_contract integer NOT NULL,
    date_paying date
);

CREATE TABLE kinder_group (
    group_id integer not null primary key ,
    group_number varchar(20) not null,
    group_age_category integer not null references age_category(age_category_id),
    group_schedule integer not null ,
    group_employee integer not null references employee(employee_id)
);

CREATE TABLE schedule (
   schedule_id integer not null primary key ,
   schedule_exercise_id integer references exercise(exercise_id),
   schedule_time_start timestamp not null,
   schedule_time_end timestamp not null,
   schedule_age_category integer not null references age_category(age_category_id),
   schedule_group integer not null references kinder_group(group_id),
   schedule_meal integer references meal(meal_id),
   schedule_premises integer not null references premises(premises_id)
);

