CREATE TABLE dish (
    dish_id INTEGER NOT NULL UNIQUE,
    dish_name VARCHAR(100) NOT NULL,
    dish_kalori INTEGER NOT NULL CHECK ( dish_kalori > 0 ),
    dish_gramm INTEGER NOT NULL CHECK ( dish_gramm > 0 )
);

CREATE TABLE premises (
    premises_id INTEGER NOT NULL UNIQUE,
    premises_number INTEGER NOT NULL,
    max_count_children INTEGER,
    premises_s INTEGER CHECK ( premises_s > 0 ),
    booking_start TIMESTAMP,
    booking_end TIMESTAMP CHECK( booking_start < booking_end )
);

CREATE TABLE type_activity (
    type_activity_id INTEGER NOT NULL UNIQUE,
    recommend_young_age INTEGER,
    recommend_old_age INTEGER,
    activity_name VARCHAR(100) NOT NULL ,
    activity_description TEXT NOT NULL,
    PRIMARY KEY(type_activity_id)
);

CREATE TABLE job_title (
    job_title_id INTEGER NOT NULL UNIQUE,
    job_title_name VARCHAR(100) NOT NULL,
    job_title_hourly_workload INTEGER NOT NULL,
    job_title_hourly_pay INTEGER NOT NULL CHECK ( job_title_hourly_pay > 0 ),
    primary key (job_title_id)
);

CREATE TABLE meal (
    meal_id INTEGER PRIMARY KEY,
    meal_type VARCHAR(20) NOT NULL
);

CREATE TABLE menu (
    menu_id INTEGER PRIMARY KEY,
    meal_id INTEGER NOT NULL REFERENCES meal(meal_id),
    dish_id INTEGER NOT NULL REFERENCES dish(dish_id),
    UNIQUE (meal_id, dish_id)
);

CREATE TABLE age_category (
  age_category_id integer not null  primary key,
  age_category_youngest  integer not null check( age_category_youngest >0 and age_category_youngest < age_category_oldest),
  age_category_oldest integer not null check(age_category_oldest > 0)
);

CREATE TABLE employee(
    employee_id integer not null primary key ,
    employee_job_title integer not null references job_title(job_title_id),
    employee_telephone varchar(15) not null,
    employee_passport varchar(100) not null,
    employee_date date not null
);

CREATE TABLE work_shift (
    work_shift_id integer not null primary key ,
    work_shift_schedule varchar(10) not null,
    work_shift_employee integer not null references employee(employee_id),
    work_shift_time_start timestamp not null,
    work_shift_time_end timestamp not null check(work_shift_time_start<work_shift_time_end)
);

create table exercise (
    exercise_id integer not null primary key ,
    exercise_activity_id integer not null references type_activity(type_activity_id),
    exercise_place varchar(100) not null,
    exercise_employee integer not null references employee(employee_id)
);

CREATE TABLE child (
    id_child integer NOT NULL PRIMARY KEY,
    FIO text NOT NULL,
    date_birth date NOT NULL,
    sex bool NOT NULL,
    birth_certificate varchar(20) NOT NULL UNIQUE,
    adress text,
    id_contract integer NOT NULL UNIQUE,
    id_group integer NOT NULL
);
--как задавать ключи check and rewrite all

CREATE TABLE medical_exam (
    id_medical_exam integer NOT NULL PRIMARY KEY,
    id_child integer REFERENCES child(id_child),
    plan text,
    date_exam date,
    results text,
    complaint text,
    status bool
 );

CREATE TABLE medical_record(
    id_medical_record integer NOT NULL PRIMARY KEY,
    id_child integer REFERENCES child(id_child),
    blood_type varchar(10) NOT NULL,
    physical_mental text,
    infections text,
    operation_complited text,
    alergic text,
    diseases text
);

CREATE TABLE vaccination(
     id_vaccination integer NOT NULL PRIMARY KEY,
     id_medical_record integer REFERENCES medical_record(id_medical_record),
     name varchar(40) NOT NULL,
     place varchar(40) NOT NULL,
     date_vac date,
     status bool,
     dose smallint
 );

CREATE TABLE parent(
    id_parent integer NOT NULL PRIMARY KEY,
    inn varchar(30) NOT NULL UNIQUE,
    date_birth date,
    id_contract INTEGER NOT NULL REFERENCES contract(id_contract),
    contact_data text NOT NULL, --телефон и почта
    passport varchar(30) NOT NULL UNIQUE,
    adress text
);
