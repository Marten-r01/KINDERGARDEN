--Последний медицинский осмотр каждого ребёнка, включая детей без осмотров
SELECT
    c.id_child,
    c.fio,
    MAX(me.date_exam) AS last_exam_date
FROM child AS c
LEFT JOIN medical_exam AS me
    ON c.id_child = me.id_child
GROUP BY c.id_child, c.fio;

--Пересекающиеся записи расписания в одном помещении
SELECT
    s1.schedule_id AS first_schedule_id,
    s2.schedule_id AS second_schedule_id,
    s1.schedule_premises AS premises_id,
    s1.schedule_time_start AS first_start,
    s1.schedule_time_end AS first_end,
    s2.schedule_time_start AS second_start,
    s2.schedule_time_end AS second_end
FROM schedule AS s1
JOIN schedule AS s2
    ON s1.schedule_premises = s2.schedule_premises
   AND s1.schedule_id < s2.schedule_id
   AND s1.schedule_time_start < s2.schedule_time_end
   AND s2.schedule_time_start < s1.schedule_time_end;
